{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "nfqws2_dns"
    },
    "schema_version": {
      "const": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "comment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "purpose",
        "operator",
        "comment"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "active",
              "draft",
              "legacy"
            ]
          },
          "origin": {
            "enum": [
              "active",
              "draft",
              "legacy"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "profile": {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": 1
              },
              "upstreams": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 80
                    },
                    "protocol": {
                      "enum": [
                        "udp",
                        "tcp",
                        "dot",
                        "doh"
                      ]
                    },
                    "address": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "tls_name": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 253
                    },
                    "url": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 2048
                    },
                    "bootstrap": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 45
                      },
                      "minItems": 0,
                      "maxItems": 8
                    },
                    "default": {
                      "type": "boolean"
                    },
                    "domains": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 253
                          },
                          "include_subdomains": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "name",
                          "include_subdomains"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 0,
                      "maxItems": 256
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "protocol",
                    "address",
                    "port",
                    "tls_name",
                    "url",
                    "bootstrap",
                    "default",
                    "domains"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 32
              },
              "records": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    },
                    "include_subdomains": {
                      "type": "boolean"
                    },
                    "addresses": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 45
                      },
                      "minItems": 1,
                      "maxItems": 8
                    },
                    "checked_at": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "minLength": 10,
                          "maxLength": 10,
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "include_subdomains",
                    "addresses",
                    "checked_at"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 64
              }
            },
            "required": [
              "schema_version",
              "upstreams",
              "records"
            ],
            "additionalProperties": false
          },
          "complete": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65536
                },
                "code": {
                  "enum": [
                    "private_url_omitted",
                    "unsupported_directive",
                    "unresolved_group",
                    "additional_directives_omitted"
                  ]
                }
              },
              "required": [
                "line",
                "code"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 128
          },
          "scope": {
            "const": "upstreams_and_domain_rules"
          }
        },
        "required": [
          "id",
          "origin",
          "sha256",
          "profile",
          "complete",
          "warnings",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "required": [
    "type",
    "schema_version",
    "context",
    "sources"
  ],
  "additionalProperties": false
}
