{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "nfqws2_import_addon"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "kind": {
      "const": "scope_domains_v1"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 253
      }
    }
  },
  "required": [
    "type",
    "schema_version",
    "id",
    "title",
    "description",
    "kind",
    "domains"
  ],
  "additionalProperties": false
}
