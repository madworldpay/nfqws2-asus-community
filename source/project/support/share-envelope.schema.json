{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 3
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "report",
              "dpi",
              "strategy"
            ]
          },
          "filename": {
            "type": "string",
            "pattern": "^NFQWS2_[A-Za-z0-9_-]+_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.json$",
            "maxLength": 128
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "data_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "maxLength": 1398104
          }
        },
        "required": [
          "type",
          "filename",
          "byte_length",
          "sha256",
          "data_base64"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^(?:ASUS-unknown|OpenWrt|(?:(?:GT|RT|TUF|DSL|4G)-(?:AC|AXE?|BE)[0-9]{2,6}(?:U|G|Go|Pro|AI|S|P|V[0-9]){0,2}|(?:RT-)?BE[0-9]{2,4}|ZenWiFi_(?:XT|ET|BT)[0-9]{1,3}))$",
          "maxLength": 64
        },
        "firmware": {
          "type": "object",
          "properties": {
            "firmver": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,8}(?:[._-][0-9]{1,8})*(?:[_-](?:gnuton|GNUTON)[0-9._-]*)?$",
                  "maxLength": 64
                }
              ]
            },
            "buildno": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,8}(?:[._-][0-9]{1,8})*(?:[_-](?:gnuton|GNUTON)[0-9._-]*)?$",
                  "maxLength": 64
                }
              ]
            },
            "extendno": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,8}(?:[._-][0-9]{1,8})*(?:[_-](?:gnuton|GNUTON)[0-9._-]*)?$",
                  "maxLength": 64
                }
              ]
            }
          },
          "required": [
            "firmver",
            "buildno",
            "extendno"
          ],
          "additionalProperties": false
        },
        "kernel": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(?:\\.[0-9]{1,4})?(?:[-_](?:merlin|asus|gnuton|[0-9_.]+))?$",
              "maxLength": 64
            }
          ]
        },
        "versions": {
          "type": "object",
          "properties": {
            "core": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.+_-]{1,64}$"
            },
            "web": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.+_-]{1,64}$"
            }
          },
          "required": [
            "core",
            "web"
          ],
          "additionalProperties": false
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "model",
        "firmware",
        "kernel",
        "versions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "submission_id",
    "files"
  ],
  "additionalProperties": false
}
