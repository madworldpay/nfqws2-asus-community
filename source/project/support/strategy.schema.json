{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "nfqws2_strategy"
    },
    "schema_version": {
      "const": 1
    },
    "versions": {
      "type": "object",
      "properties": {
        "core": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+_-]{1,64}$"
        },
        "web": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+_-]{1,64}$"
        }
      },
      "required": [
        "core",
        "web"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "enum": [
              "NFQWS_ARGS",
              "NFQWS_ARGS_QUIC",
              "NFQWS_ARGS_UDP",
              "NFQWS_ARGS_CUSTOM"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "operator": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "pattern": "\\S"
    },
    "comment": {
      "type": "string",
      "maxLength": 2000
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:RESOURCE|VARIABLE|BLOB|NETWORK)_[1-9][0-9]{0,2}$"
          },
          "kind": {
            "enum": [
              "file",
              "variable",
              "blob",
              "network"
            ]
          },
          "included": {
            "const": false
          }
        },
        "required": [
          "id",
          "kind",
          "included"
        ],
        "additionalProperties": false
      }
    },
    "mode": {
      "enum": [
        "blocks",
        "config"
      ]
    },
    "config": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "omitted_options": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "required": [
    "type",
    "schema_version",
    "versions",
    "purpose",
    "operator",
    "comment",
    "dependencies",
    "mode"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "mode": {
          "const": "blocks"
        },
        "config": false,
        "omitted_options": false
      },
      "required": [
        "blocks"
      ]
    },
    {
      "properties": {
        "mode": {
          "const": "config"
        },
        "blocks": false
      },
      "required": [
        "config",
        "omitted_options"
      ]
    }
  ]
}
