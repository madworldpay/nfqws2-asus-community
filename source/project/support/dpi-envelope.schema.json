{
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "report"
            },
            "filename": {
              "type": "string",
              "pattern": "^NFQWS2_[A-Za-z0-9_-]{1,64}_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.json$",
              "maxLength": 128
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "data_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "maxLength": 1398104
            }
          },
          "required": [
            "type",
            "filename",
            "byte_length",
            "sha256",
            "data_base64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "dpi"
            },
            "filename": {
              "type": "string",
              "pattern": "^NFQWS2_DPI_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.json$",
              "maxLength": 128
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "data_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "maxLength": 349528
            }
          },
          "required": [
            "type",
            "filename",
            "byte_length",
            "sha256",
            "data_base64"
          ],
          "additionalProperties": false
        }
      ],
      "items": false
    }
  },
  "required": [
    "version",
    "submission_id",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
