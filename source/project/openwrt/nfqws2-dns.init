#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=09
case "$action" in stop|restart|reload)
    /usr/bin/php-cgi -d register_argc_argv=1 -q -f /usr/lib/nfqws2/smartdns/native-control.php -- can-stop || exit 1;;
esac
start_service() {
    procd_open_instance managed
    procd_set_param command /bin/sh /usr/lib/nfqws2/smartdns/runtime.sh
    # Owner loss triggers bounded rollback; an unconfirmed profile never resumes.
    procd_set_param respawn 3600 1 5
    procd_set_param term_timeout 20
    procd_set_param stderr 1
    procd_close_instance
}
