#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

NFQWS_CONTROL=${NFQWS_CONTROL:-/usr/lib/nfqws2/control.sh}
NFQWS_RUN=${NFQWS_RUN:-/var/run/nfqws2-native}

# rc.common closes the procd transaction even if start_service fails. Validate
# before its restart/stop transaction can replace an existing working instance.
case "$action" in start|restart|reload|boot)
    "$NFQWS_CONTROL" preflight && "$NFQWS_CONTROL" firewall || exit 1;;
esac

start_service() {
    . "$NFQWS_RUN/launch.env" || return 1
    set -f
    # Arguments are data from the bounded parser. No eval or shell re-expansion.
    set -- $NFQWS_LAUNCH_ARGS
    procd_open_instance main
    procd_set_param command /usr/bin/nfqws2 "$@"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/nfqws2/nfqws2.conf
    procd_close_instance
}

service_started() {
    "$NFQWS_CONTROL" check-started || { stop; return 1; }
}

stop_service() { "$NFQWS_CONTROL" remove-firewall; }
reload_service() { start; }

service_triggers() {
    procd_add_reload_trigger network firewall
    procd_add_raw_trigger 'interface.*' 1000 /usr/lib/nfqws2/control.sh network-event
}

EXTRA_COMMANDS="check diagnostics"
EXTRA_HELP="        check          Check process and queue binding
        diagnostics    Read traffic and interface facts"
check() { "$NFQWS_CONTROL" check; }
diagnostics() { "$NFQWS_CONTROL" diagnostics; }
status_service() { "$NFQWS_CONTROL" status; }
