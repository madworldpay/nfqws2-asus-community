#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

case "$action" in start|stop|restart|reload|boot|shutdown|scheduledrestart)
    . /usr/lib/nfqws2/update/service-lease.sh || exit 1
    nfqws_native_update_enter core "$action" || exit 1;;
esac

NFQWS_CONTROL=${NFQWS_CONTROL:-/usr/lib/nfqws2/control.sh}
NFQWS_RUN=${NFQWS_RUN:-/var/run/nfqws2-native}

# rc.common closes the procd transaction even if start_service fails. Validate
# before its restart/stop transaction can replace an existing working instance.
case "$action" in start|restart|boot)
    "$NFQWS_CONTROL" preflight && "$NFQWS_CONTROL" firewall || exit 1;;
esac

start_service() {
    # rc.common restart invokes stop_service after the entry preflight. That
    # stop removes the old capture table, so recreate it for every new instance.
    "$NFQWS_CONTROL" firewall || return 1
    . "$NFQWS_RUN/launch.env" || return 1
    case "$action" in start|restart|boot) rm -f "$NFQWS_RUN/watchdog-state";; esac
    # The validated launch commits running intent even if the daemon exits
    # before queue readiness. Recovery then follows the same bounded policy.
    touch "$NFQWS_RUN/started" || return 1
    set -f
    # Arguments are data from the bounded parser. No eval or shell re-expansion.
    set -- $NFQWS_LAUNCH_ARGS
    procd_open_instance main
    procd_set_param command /usr/bin/nfqws2 "$@"
    # Recovery is opt-in and bounded by our minute watchdog. A second procd
    # respawner would bypass OFF, increasing delays and the three-attempt latch.
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/nfqws2/nfqws2.conf
    procd_close_instance
}

service_started() {
    "$NFQWS_CONTROL" check-started || { stop; return 1; }
    if [ -f /usr/lib/nfqws2/restart-schedule.sh ]; then
        . /usr/lib/nfqws2/restart-schedule.sh
        NFQWS_RESTART_CONFIG=${NFQWS_RESTART_CONFIG:-/etc/nfqws2/restart-schedule.conf}
        RUN_DIR=$NFQWS_RUN nfqws_watchdog_running
    fi
}

stop_service() {
    # rc.common ignores this hook's return value. Abort on a real cleanup
    # failure; otherwise it could delete the process and still report success.
    "$NFQWS_CONTROL" remove-firewall || exit 1
    case "$action" in stop|shutdown)
        rm -f "$NFQWS_RUN/started" "$NFQWS_RUN/watchdog-state"
        # procd_lock is already held by rc.common. An absent registration is
        # an ordinary repeated stop, but still needs the capture cleanup above.
        local registration
        registration=$(ubus -S call service list '{"name":"nfqws2-native"}') || exit 1
        [ "$registration" != '{}' ] || exit 0
        ;;
    esac
}
reload_service() {
    # procd holds its mutex here. A queued network/config event must not start
    # a stopped or crashed instance, bypassing OFF, delays or an exhausted latch.
    [ -f "$NFQWS_RUN/started" ] || return 0
    "$NFQWS_CONTROL" process-pid >/dev/null || return 0
    "$NFQWS_CONTROL" preflight && "$NFQWS_CONTROL" firewall || return 1
    "$NFQWS_CONTROL" process-pid >/dev/null || return 0
    start
}

service_triggers() {
    procd_add_reload_trigger network firewall
    procd_add_raw_trigger 'interface.*' 1000 /usr/lib/nfqws2/control.sh network-event
}

EXTRA_COMMANDS="check diagnostics scheduledrestart"
EXTRA_HELP="        check          Check process and queue binding
        diagnostics    Read traffic and interface facts"
check() { "$NFQWS_CONTROL" check; }
diagnostics() { "$NFQWS_CONTROL" diagnostics; }
status_service() { "$NFQWS_CONTROL" status; }

scheduledrestart() {
    # rc.common loads procd.sh (and acquires its service mutex) before extra
    # commands. Check the actual process only after a concurrent stop finishes.
    local pid
    [ -f "$NFQWS_RUN/started" ] || return 0
    . /usr/lib/nfqws2/restart-schedule.sh || return 1
    NFQWS_RESTART_CONFIG=${NFQWS_RESTART_CONFIG:-/etc/nfqws2/restart-schedule.conf}
    NFQWS_RESTART_STATE=${NFQWS_RESTART_STATE:-$NFQWS_RUN/restart-schedule}
    RUN_DIR=$NFQWS_RUN
    if pid=$("$NFQWS_CONTROL" process-pid); then
        nfqws_watchdog_running || return 1
        nfqws_restart_schedule_due "$pid" || return 0
    else
        nfqws_watchdog_attempt || return 0
    fi
    "$NFQWS_CONTROL" preflight && "$NFQWS_CONTROL" firewall || return 1
    restart
}
