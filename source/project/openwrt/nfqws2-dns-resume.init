#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=08
# Inert without a saved, explicitly confirmed profile. The ordinary firmware
# DNS starts first; only a freshly validated confirmed intent may reconnect.
start_service() {
    procd_open_instance resume
    procd_set_param command /bin/sh /usr/lib/nfqws2/smartdns/resume.sh
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
