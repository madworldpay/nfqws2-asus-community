# Optional include inside an existing HTTPS server {}, before regex locations.
# Uses existing nginx-http.conf.example zones and @nfqws_profile_limited handler.
# Set aliases to the reviewed add-on directory on that existing server.
location = /nfqws-profiles/v1/addons/catalog.json {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    alias /srv/nfqws-profiles/v1/addons/catalog.json;
    autoindex off;
    default_type application/json;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-cache" always;
    disable_symlinks on;
    max_ranges 0;
    limit_req zone=nfqws_profile_requests burst=10 nodelay;
    limit_req_status 429;
    limit_conn nfqws_profile_connections 8;
    limit_conn_status 429;
    error_page 429 = @nfqws_profile_limited;
}

location ~ "^/nfqws-profiles/v1/addons/files/(?<nfqws_addon_sha>[a-f0-9]{64})\.json$" {
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }
    alias /srv/nfqws-profiles/v1/addons/files/$nfqws_addon_sha.json;
    autoindex off;
    default_type application/json;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    disable_symlinks on;
    max_ranges 0;
    limit_rate 512k;
    limit_req zone=nfqws_profile_requests burst=10 nodelay;
    limit_req_status 429;
    limit_conn nfqws_profile_connections 8;
    limit_conn_status 429;
    error_page 429 = @nfqws_profile_limited;
}

location /nfqws-profiles/v1/addons/ {
    autoindex off;
    return 404;
}
