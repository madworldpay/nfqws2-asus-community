{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NFQWS2 signed native OpenWrt release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "package",
    "core_version",
    "web_version",
    "build",
    "notes",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "platform": {
      "const": "openwrt"
    },
    "package": {
      "const": "nfqws2-native"
    },
    "core_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$",
      "maxLength": 32
    },
    "web_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$",
      "maxLength": 32
    },
    "build": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "series",
          "arch",
          "format",
          "version",
          "filename",
          "size",
          "sha256",
          "installed_size"
        ],
        "properties": {
          "series": {
            "enum": [
              "24.10",
              "25.12"
            ]
          },
          "arch": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_+-]{0,99}$"
          },
          "format": {
            "enum": [
              "ipk",
              "apk"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})-(?:r)?[1-9][0-9]{0,9}$",
            "maxLength": 64
          },
          "filename": {
            "type": "string",
            "pattern": "^nfqws2-native_[a-zA-Z0-9._+-]+\\.(?:ipk|apk)$",
            "maxLength": 200
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "installed_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          }
        }
      }
    }
  }
}
